<?xml version="1.0" encoding="UTF-8"?>
<!-- XML 声明：文档使用 XML 1.0 语法，并采用 UTF-8 字符编码。 -->
<!-- Maven 项目对象模型根元素：声明 POM 命名空间、XML Schema 实例命名空间以及模型约束文件位置。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- Maven 项目对象模型版本固定为 4.0.0。 -->
    <modelVersion>4.0.0</modelVersion>

    <!-- 继承 Spring Boot 父项目，以获得统一的依赖版本管理、插件配置和构建默认值。 -->
    <parent>
        <!-- Spring Boot 父项目所属的组织坐标。 -->
        <groupId>org.springframework.boot</groupId>
        <!-- 使用 Spring Boot Starter Parent 作为当前项目的父 POM。 -->
        <artifactId>spring-boot-starter-parent</artifactId>
        <!-- Spring Boot 父项目版本为 3.3.5，并据此管理兼容的依赖版本。 -->
        <version>3.3.5</version>
        <!-- 空的 relativePath 表示不从本地相对路径查找父 POM，而从 Maven 仓库解析。 -->
        <relativePath/>
    </parent>

    <!-- 当前项目的组织标识为 com.petadoption。 -->
    <groupId>com.petadoption</groupId>
    <!-- 当前项目的构件名称为 pet-mgt，也是生成构建产物时使用的基础名称。 -->
    <artifactId>pet-mgt</artifactId>
    <!-- 当前项目版本为 1.0.0。 -->
    <version>1.0.0</version>
    <!-- Maven 项目显示名称为 pet-mgt。 -->
    <name>pet-mgt</name>
    <!-- 项目描述：宠物领养管理平台；保留原有描述文本不变。 -->
    <description>Pet adoption management platform</description>

    <!-- 集中声明可在当前 POM 中复用的版本属性。 -->
    <properties>
        <!-- Java 编译及运行版本设为 17，供 Spring Boot 父项目的编译插件配置使用。 -->
        <java.version>17</java.version>
        <!-- 自定义 MyBatis Spring Boot Starter 版本属性，当前版本为 3.0.3。 -->
        <mybatis-spring-boot.version>3.0.3</mybatis-spring-boot.version>
    </properties>

    <!-- 项目依赖列表，包含 Web、模板、安全、校验、持久层、数据库驱动及测试依赖。 -->
    <dependencies>
        <!-- Spring MVC Web 开发起步依赖，提供内嵌 Tomcat、Spring MVC 和 JSON 处理等能力。 -->
        <dependency>
            <!-- 该依赖属于 Spring Boot 组织。 -->
            <groupId>org.springframework.boot</groupId>
            <!-- Web 起步依赖构件，版本由 Spring Boot 父 POM 统一管理。 -->
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- Thymeleaf 模板引擎起步依赖，用于渲染服务端 HTML 页面。 -->
        <dependency>
            <!-- 该依赖属于 Spring Boot 组织。 -->
            <groupId>org.springframework.boot</groupId>
            <!-- Thymeleaf 起步依赖构件，版本由 Spring Boot 父 POM 统一管理。 -->
            <artifactId>spring-boot-starter-thymeleaf</artifactId>
        </dependency>
        <!-- Thymeleaf 的 Spring Security 6 扩展，用于在模板中进行权限判断和安全标签渲染。 -->
        <dependency>
            <!-- Thymeleaf 扩展模块所属的组织坐标。 -->
            <groupId>org.thymeleaf.extras</groupId>
            <!-- 与 Spring Security 6 集成的 Thymeleaf 扩展构件，版本由父 POM 管理。 -->
            <artifactId>thymeleaf-extras-springsecurity6</artifactId>
        </dependency>
        <!-- Spring Security 起步依赖，为应用提供身份认证、授权和安全过滤器链。 -->
        <dependency>
            <!-- 该依赖属于 Spring Boot 组织。 -->
            <groupId>org.springframework.boot</groupId>
            <!-- Spring Security 起步依赖构件，版本由 Spring Boot 父 POM 统一管理。 -->
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <!-- Bean Validation 起步依赖，用于校验控制器参数、表单对象及其他 Java Bean。 -->
        <dependency>
            <!-- 该依赖属于 Spring Boot 组织。 -->
            <groupId>org.springframework.boot</groupId>
            <!-- Validation 起步依赖构件，提供 Jakarta Validation API 及实现。 -->
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <!-- MyBatis Spring Boot 起步依赖，用于整合 MyBatis、Spring 数据源和事务管理。 -->
        <dependency>
            <!-- MyBatis Spring Boot 模块所属的组织坐标。 -->
            <groupId>org.mybatis.spring.boot</groupId>
            <!-- MyBatis 与 Spring Boot 自动配置集成构件。 -->
            <artifactId>mybatis-spring-boot-starter</artifactId>
            <!-- 引用上方自定义属性，将 MyBatis Starter 版本设为 3.0.3。 -->
            <version>${mybatis-spring-boot.version}</version>
        </dependency>
        <!-- MySQL JDBC 驱动，用于在应用运行时连接 MySQL 数据库。 -->
        <dependency>
            <!-- MySQL 驱动所属的组织坐标。 -->
            <groupId>com.mysql</groupId>
            <!-- MySQL Connector/J 驱动构件，版本由 Spring Boot 父 POM 管理。 -->
            <artifactId>mysql-connector-j</artifactId>
            <!-- runtime 表示该驱动只在运行和测试运行时需要，不参与业务代码编译。 -->
            <scope>runtime</scope>
        </dependency>
        <!-- Lombok 注解处理依赖，用于在编译期生成 getter、setter、构造方法等样板代码。 -->
        <dependency>
            <!-- Lombok 所属的组织坐标。 -->
            <groupId>org.projectlombok</groupId>
            <!-- Lombok 核心构件，版本由 Spring Boot 父 POM 管理。 -->
            <artifactId>lombok</artifactId>
            <!-- optional 为 true，避免将 Lombok 作为传递依赖暴露给依赖本项目的其他模块。 -->
            <optional>true</optional>
        </dependency>
        <!-- Spring Boot 测试起步依赖，提供 JUnit、AssertJ、Mockito 和 Spring Test 等测试工具。 -->
        <dependency>
            <!-- 该依赖属于 Spring Boot 组织。 -->
            <groupId>org.springframework.boot</groupId>
            <!-- Spring Boot 测试起步依赖构件，版本由父 POM 统一管理。 -->
            <artifactId>spring-boot-starter-test</artifactId>
            <!-- test 表示该依赖只用于测试代码编译和测试运行，不打入生产运行包。 -->
            <scope>test</scope>
        </dependency>
        <!-- Spring Security 测试支持，用于模拟认证用户并测试安全配置和访问控制。 -->
        <dependency>
            <!-- Spring Security 所属的组织坐标。 -->
            <groupId>org.springframework.security</groupId>
            <!-- Spring Security 测试构件，版本由 Spring Boot 父 POM 统一管理。 -->
            <artifactId>spring-security-test</artifactId>
            <!-- test 表示安全测试工具仅在测试阶段可用。 -->
            <scope>test</scope>
        </dependency>
    </dependencies>

    <!-- Maven 构建配置。 -->
    <build>
        <!-- 构建过程中使用的 Maven 插件列表。 -->
        <plugins>
            <!-- Spring Boot Maven 插件，用于运行应用并将项目打包为可执行 Spring Boot JAR。 -->
            <plugin>
                <!-- 插件所属的组织坐标为 Spring Boot。 -->
                <groupId>org.springframework.boot</groupId>
                <!-- Spring Boot Maven 插件构件，版本由父 POM 的插件管理配置提供。 -->
                <artifactId>spring-boot-maven-plugin</artifactId>
                <!-- Spring Boot Maven 插件的自定义执行配置。 -->
                <configuration>
                    <!-- 配置重新打包为可执行 JAR 时需要排除的依赖列表。 -->
                    <excludes>
                        <!-- 定义一项要从可执行包中排除的依赖。 -->
                        <exclude>
                            <!-- 被排除依赖的组织坐标为 Lombok。 -->
                            <groupId>org.projectlombok</groupId>
                            <!-- 排除 Lombok 构件，因为它是编译期工具，无需包含在最终可执行 JAR 中。 -->
                            <artifactId>lombok</artifactId>
                        </exclude>
                    </excludes>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
