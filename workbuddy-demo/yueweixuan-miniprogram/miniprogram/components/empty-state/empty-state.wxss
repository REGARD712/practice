.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
}

.empty-icon {
  width: 200rpx;
  height: 200rpx;
}

.empty-text {
  margin-top: 24rpx;
  font-size: var(--font-size-base);
  color: var(--color-text-secondary);
}

.empty-sub {
  margin-top: 12rpx;
  font-size: var(--font-size-sm);
  color: var(--color-text-third);
}

.empty-btn {
  margin-top: 40rpx;
  padding: 16rpx 64rpx;
  border-radius: 40rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: var(--font-size-base);
}
