<view class="page">

  <!-- 购物车列表 -->
  <block wx:if="{{items.length > 0}}">
    <view class="list">
      <view wx:for="{{items}}" wx:key="id" class="cart-item card">
        <image class="item-img" src="{{item.imageSrc}}" mode="aspectFill" lazy-load />
        <view class="item-info">
          <view class="item-top">
            <text class="item-name">{{item.name}}</text>
            <text class="item-remove" bindtap="onRemove" data-id="{{item.id}}">删除</text>
          </view>
          <view class="item-bottom">
            <text class="price"><text class="symbol">¥</text>{{item.priceYuan}}</text>
            <view class="stepper">
              <view class="step-btn minus" bindtap="onMinus" data-id="{{item.id}}"><text>−</text></view>
              <text class="step-num">{{item.quantity}}</text>
              <view class="step-btn" bindtap="onAdd" data-id="{{item.id}}"><text>+</text></view>
            </view>
          </view>
        </view>
      </view>
    </view>

    <view class="footer-space"></view>

    <!-- 底部结算栏 -->
    <view class="checkout-bar safe-bottom">
      <view class="total">
        <text class="total-label">共 {{totalCount}} 件</text>
        <text class="price big"><text class="symbol">¥</text>{{totalAmountYuan}}</text>
      </view>
      <view class="checkout-btn {{submitting ? 'disabled' : ''}}" bindtap="onCheckout">
        <text>{{submitting ? '下单中...' : '去结算'}}</text>
      </view>
    </view>
  </block>

  <!-- 空状态 -->
  <empty-state
    wx:else
    text="购物车还是空的"
    subText="去挑几道喜欢的菜品吧"
    buttonText="去点单"
    bind:action="goMenu"
  />
</view>
