<view class="page">

  <!-- 步骤一：微信一键登录 -->
  <view class="panel card" wx:if="{{stage === 'signin'}}">
    <view class="panel-title">
      <text>微信授权登录</text>
    </view>
    <view class="panel-desc">
      <text>登录后可保存点单记录，并在首页展示您的头像和昵称，仅用于本店点单服务</text>
    </view>
    <button class="wechat-btn {{signing ? 'disabled' : ''}}" bindtap="onWechatLogin">
      {{signing ? '登录中...' : '微信一键登录'}}
    </button>
  </view>

  <!-- 步骤二：完善头像昵称 -->
  <view class="panel card" wx:if="{{stage === 'profile'}}">
    <view class="panel-title">
      <text>完善资料</text>
    </view>
    <view class="panel-desc">
      <text>设置头像和昵称，完成登录</text>
    </view>

    <!-- 头像选择（官方头像昵称填写能力） -->
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatarTemp}}" class="avatar-img" src="{{avatarTemp}}" mode="aspectFill" />
      <image wx:elif="{{avatarCurrent}}" class="avatar-img" src="{{avatarCurrent}}" mode="aspectFill" />
      <view wx:else class="avatar-img avatar-placeholder">
        <text>选择头像</text>
      </view>
    </button>

    <!-- 昵称填写 -->
    <view class="field">
      <text class="field-label">昵称</text>
      <input
        class="field-input"
        type="nickname"
        value="{{nickname}}"
        bindinput="onNicknameInput"
        placeholder="请输入昵称"
        placeholder-class="placeholder"
      />
    </view>

    <view class="submit-btn btn-primary {{submitting ? 'disabled' : ''}}" bindtap="onSubmit">
      <text>{{submitting ? '提交中...' : '保存并登录'}}</text>
    </view>
  </view>

  <!-- 登录态检测中 -->
  <view wx:if="{{stage === 'loading'}}" class="loading-tip">
    <text>加载中...</text>
  </view>
</view>
