<view class="page">

  <!-- 左右布局：分类栏 + 菜品列表 -->
  <view class="menu-body">

    <!-- 左侧分类栏 -->
    <scroll-view class="category-panel" scroll-y enhanced show-scrollbar="{{false}}">
      <view
        wx:for="{{categories}}"
        wx:key="_id"
        class="category-item {{activeIndex === index ? 'active' : ''}}"
        bindtap="onCategoryTap"
        data-index="{{index}}"
      >
        <text>{{item.name}}</text>
      </view>
    </scroll-view>

    <!-- 右侧菜品列表 -->
    <scroll-view class="dish-panel" scroll-y enhanced show-scrollbar="{{false}}">
      <view wx:if="{{!loading && dishList.length === 0}}" class="panel-empty">
        <text>该分类暂无菜品</text>
      </view>

      <view
        wx:for="{{dishList}}"
        wx:key="_id"
        class="dish-item card"
        bindtap="onDishTap"
        data-id="{{item._id}}"
      >
        <image class="dish-img" src="{{item.imageSrc}}" mode="aspectFill" lazy-load />
        <view class="dish-info">
          <text class="dish-name">{{item.name}}</text>
          <text class="dish-desc">{{item.desc}}</text>
          <text class="dish-sales">月售 {{item.sales}}</text>
          <view class="dish-bottom">
            <text class="price"><text class="symbol">¥</text>{{item.priceYuan}}</text>
            <!-- 数量步进器：已在购物车时显示 减号+数量 -->
            <view class="stepper" wx:if="{{item.quantity > 0}}">
              <view class="step-btn minus" catchtap="onMinus" data-id="{{item._id}}">
                <text>−</text>
              </view>
              <text class="step-num">{{item.quantity}}</text>
            </view>
            <view class="step-btn" catchtap="onAdd" data-id="{{item._id}}">
              <text>+</text>
            </view>
          </view>
        </view>
      </view>

      <view class="panel-space"></view>
    </scroll-view>
  </view>

  <!-- 底部购物车栏 -->
  <view class="cart-bar safe-bottom">
    <view class="cart-bar-left" bindtap="goCart">
      <view class="cart-icon-wrap">
        <image class="cart-icon" src="/assets/icons/cart-active.png" mode="aspectFit" />
        <view wx:if="{{cartCount > 0}}" class="cart-badge">{{cartCount}}</view>
      </view>
      <view class="cart-amount">
        <text class="price"><text class="symbol">¥</text>{{cartAmountYuan}}</text>
      </view>
    </view>
    <view class="cart-bar-btn {{cartCount > 0 ? '' : 'disabled'}}" bindtap="goCart">
      <text>去结算</text>
    </view>
  </view>
</view>
