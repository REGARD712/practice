.page {
  padding-bottom: 160rpx;
}

.hero-img {
  width: 100%;
  height: 480rpx;
  display: block;
}

.info-card {
  margin: -40rpx 24rpx 0;
  position: relative;
  padding: 28rpx;
}

.info-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dish-name {
  font-size: var(--font-size-xl);
  font-weight: 700;
}

.tag-row {
  display: flex;
}

.tag {
  margin-left: 12rpx;
  padding: 4rpx 14rpx;
  font-size: var(--font-size-xs);
  color: var(--color-primary);
  background: var(--color-primary-light);
  border-radius: var(--radius-sm);
}

.meta-row {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.meta {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
}

.meta-divider {
  margin: 0 16rpx;
  color: var(--color-line);
}

.price-row {
  margin-top: 18rpx;
}

.price.big {
  font-size: 48rpx;
}

.price.big .symbol {
  font-size: var(--font-size-lg);
}

.desc-card {
  margin: 20rpx 24rpx 0;
  padding: 28rpx;
}

.desc-title {
  font-size: var(--font-size-lg);
  font-weight: 600;
  margin-bottom: 16rpx;
}

.desc-text {
  font-size: var(--font-size-sm);
  color: var(--color-text-secondary);
  line-height: 1.8;
}

.footer-space {
  height: 40rpx;
}

/* 底部操作栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: var(--color-card);
  padding: 16rpx 32rpx;
  box-shadow: 0 -4rpx 24rpx rgba(0, 0, 0, 0.06);
}

.stepper {
  display: flex;
  align-items: center;
}

.step-num {
  min-width: 64rpx;
  text-align: center;
  font-size: var(--font-size-lg);
  font-weight: 600;
}

.step-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: var(--color-primary);
  color: #ffffff;
  font-size: var(--font-size-xl);
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.step-btn.minus {
  background: #ffffff;
  border: 2rpx solid var(--color-primary);
  color: var(--color-primary);
}

.step-btn.minus.off {
  border-color: var(--color-line);
  color: var(--color-line);
}

.add-cart-btn {
  display: flex;
  align-items: center;
  padding: 20rpx 48rpx;
  border-radius: 44rpx;
  background: var(--color-primary);
  color: #ffffff;
  font-size: var(--font-size-lg);
  font-weight: 600;
}

.btn-sep {
  margin-left: 20rpx;
  padding-left: 20rpx;
  border-left: 2rpx solid rgba(255, 255, 255, 0.4);
}
